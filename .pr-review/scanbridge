#!/bin/sh
set -eu

if command -v scanbridge >/dev/null 2>&1; then
  exec scanbridge "$@"
fi

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
local_cli="$project_root/../scanbridge/dist/src/cli/main.js"

if [ ! -f "$local_cli" ]; then
  echo "Scanbridge was not found in PATH or at $local_cli" >&2
  echo "Build the sibling scanbridge project or install the scanbridge command." >&2
  exit 127
fi

exec node "$local_cli" "$@"
